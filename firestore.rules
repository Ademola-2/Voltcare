rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin";
    }
    // Create admins/{uid} manually in Firebase Console; client writes are forbidden.
    match /admins/{adminUid} {
      allow read: if signedIn() && request.auth.uid == adminUid;
      allow write: if false;
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(["role", "admin", "isAdmin"]);
      allow delete: if false;
      match /savedCalculations/{calculationId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
    match /lessons/{lessonId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}